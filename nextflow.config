params {

    /*
     * Input data
     */
    pod5 = "data/pod5"

    metadata = "references/Database_test.txt"

    /*
     * Output directory
     */
    outdir = "results"

    /*
     * General
     */
    threads = 8

    /*
     * Canu
     */
    genomeSize = "10k"
    canu_prefix = "canu_assembly"

    /*
     * Dorado
     */
    dorado_model = "dna_r10.4.1_e8.2_400bps_sup@v5.2.0"
    kit_name = "SQK-NBD114-96"

    /*
     * Human reference
     */
    human_ref = "references/Human/human_g1k_v37.fasta"
    human_index = "references/Human/human_g1k_v37.mmi"

    /*
     * NanoQ
     */
    min_quality = 15
    min_length = 800
    max_length = 1200

    /*
     * Medaka
     */
    medaka_model = "r1041_e82_400bps_sup_v5.2.0"

    /*
     * Reporting
     */
    hiv_alignment = "references/HIV/HIV_aligned_references.fasta"
}