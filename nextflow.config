/*
 * ============================================================
 * NanoHIV-DR
 * Docker / local configuration
 * ============================================================
 */


/*
 * ============================================================
 * Parameters
 * ============================================================
 */

params {

    /*
     * User inputs
     */
    pod5 = null
    metadata = null
    consensus = null

    /*
     * Pipeline stage
     */
    stage = ''

    /*
     * Output
     */
    outdir = 'results'

    /*
     * General
     */
    threads = 8
    device = 'auto'

    /*
     * Dorado
     */
    dorado_model = 'dna_r10.4.1_e8.2_400bps_sup@v5.2.0'
    kit_name = 'SQK-NBD114-96'

    /*
     * NanoQ
     */
    min_quality = 15
    min_length = 800
    max_length = 1200

    /*
     * Human reference
     */
    human_ref = "${baseDir}/references/Human/human_g1k_v37.fasta"

    /*
     * HIV reference
     */
    hiv_ref = "${baseDir}/references/HIV/HXB2-pol.fasta"
    hiv_index = "${baseDir}/references/HIV/HXB2-pol.mmi"

    /*
     * Medaka
     */
    medaka_model = 'r1041_e82_400bps_sup_v5.2.0'

    /*
     * CodFreq
     */
    codfreq_profile = "${baseDir}/references/HIV/HIV1.json"

    /*
     * Metadata
     */
    metadata_id_column = 'sample_id'

    /*
     * Reporting
     */
    hiv_alignment =
        "${baseDir}/references/HIV/HIV_aligned_references.fasta"
}


/*
 * ============================================================
 * Docker
 * ============================================================
 */

docker {

    enabled = true

    /*
     * The image was built as linux/amd64.
     *
     * The Mac is Apple Silicon (arm64), therefore Docker Desktop
     * must run the container through amd64 emulation.
     */
    runOptions = '--platform linux/amd64'
}


/*
 * ============================================================
 * Global process configuration
 * ============================================================
 */

process {

    /*
     * NanoHIV-DR Docker image
     */
    container = 'nanohiv-dr-cpu:latest'

    /*
     * Default CPU allocation
     */
    cpus = params.threads

    /*
     * Continue independent processes where possible.
     *
     * NOTE:
     * This does NOT make a process with missing inputs run.
     * It only prevents an individual process failure from
     * immediately terminating the entire workflow.
     */
    errorStrategy = 'ignore'
}


/*
 * ============================================================
 * Process-specific resources
 * ============================================================
 */

process {

    withName: DORADO_BASECALL {

        cpus = 8

    }

    withName: DORADO_DEMUX {

        cpus = 8

    }

    withName: SANITIZEME {

        cpus = 8

    }

    withName: NANOQ {

        cpus = 8

    }

    withName: MEDAKA {

        cpus = 8

    }

    withName: MINIMAP2 {

        cpus = 8

    }

    withName: CODFREQ {

        cpus = 8

    }

    withName: CHECKPOINT_CONSENSUS {

        cpus = 2

    }

    withName: VALIDATE_METADATA {

        cpus = 2

    }

    withName: REPORT {

        cpus = 4

    }
}


/*
 * ============================================================
 * Trace
 * ============================================================
 */

trace {

    enabled = true

    overwrite = true
}


/*
 * ============================================================
 * Execution report
 * ============================================================
 */

report {

    enabled = true

    overwrite = true
}


/*
 * ============================================================
 * Timeline
 * ============================================================
 */

timeline {

    enabled = true

    overwrite = true
}
