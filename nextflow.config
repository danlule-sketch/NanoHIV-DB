params {

    /*
     * Input data
     */
    pod5 = "data/pod5"

    metadata = "references/Database_test.txt"

    /*
     * Output directory
     */
    outdir = "results"

    /*
     * General
     */
    threads = 8

    /*
     * Dorado
     */
    dorado_model = "dna_r10.4.1_e8.2_400bps_sup@v5.2.0"
    kit_name = "SQK-NBD114-96"

    /*
     * NanoQ
     */
    min_quality = 15
    min_length = 800
    max_length = 1200

    /*
     * HIV-1 pol reference
     */
    hiv_ref = "references/HIV/HXB2-pol.fasta"
    hiv_index = "references/HIV/HXB2-pol.mmi"

    /*
     * Medaka
     */
    medaka_model = "r1041_e82_400bps_sup_v5.2.0"

    /*
     * CodFreq
     */
    codfreq_profile = "references/HIV/HIV1.json"

    /*
     * Reporting
     */
    hiv_alignment = "references/HIV/HIV_aligned_references.fasta"
}